# Copy to docker/.env and edit. docker compose reads it automatically.

# Password for the image's postgres superuser (initdb and tests only).
POSTGRES_PASSWORD=change-me-too

# Password for the "schemaverse" game owner role. Players get their own roles.
SCHEMAVERSE_PASSWORD=change-me

# PostgreSQL image. 19 beta is the default on purpose; use postgres:18 if a beta breaks.
PG_IMAGE=postgres:19beta3

# Port published on the host for psql access.
PG_PORT=5432

# Seconds between tics. 60 is the classic public-server pace; 5 is nice for a classroom.
TIC_SECONDS=60

# Log statements slower than this many milliseconds.
LOG_SLOW_MS=2000

# Run fleet scripts in parallel (1 = classic sequential order).
FLEET_CONCURRENCY=1

# Web interface. REGISTRAR_PASSWORD lets it create players; leave empty to disable registration from the browser.
# SPECTATOR_PASSWORD lets it serve the public pages (player profiles, shared fleet scripts, round replays)
# without a login; leave empty and those pages are off.
REGISTRAR_PASSWORD=change-me-three
SPECTATOR_PASSWORD=change-me-four
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080

# One connection per logged-in browser session plus the ticker.
PG_MAX_CONNECTIONS=300

# Production overlay (compose.prod.yml): TLS via Caddy, nightly backups.
DOMAIN=play.example.com
ACME_EMAIL=you@example.com
BACKUP_KEEP_DAYS=14
PG_SSL=off
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB
# io_method: worker (default) or io_uring on Linux hosts that allow it (PostgreSQL 18+ async I/O)
PG_IO_METHOD=worker
